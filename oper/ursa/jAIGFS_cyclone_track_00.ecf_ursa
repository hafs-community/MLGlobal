#!/bin/ksh
  
##SBATCH --job-name=aigfs_tc_tracker
##SBATCH --account=nems
##SBATCH --qos=debug
##SBATCH --ntasks=1
#
###SBATCH --nodes=17
###SBATCH --tasks-per-node=80
###SBATCH --cpus-per-task=2
#
##SBATCH --time=00:30:00
##SBATCH --mem=90g
##SBATCH -o aigfs_tc_tracker.log
#

#%include <head.h> 
#%include <envir-p2.h>

export clustername=ursa
module use /scratch3/NCEPDEV/nems/Linlin.Cui/git/others/TC_tracker/modulefiles
module load ${clustername}.lua
module list

set -x
export envir=dev

export PACKAGEROOT=/scratch3/NCEPDEV/nems/Linlin.Cui/git/others/TC_tracker
#export DATAROOT=/scratch3/NCEPDEV/stmp/Linlin.Cui/ptmp
export DATAROOT=/scratch3/NCEPDEV/stmp/${USER}/${SUBEXPT:-EAGLE_ensemble}/ens_tracker
export COMROOT=${DATAROOT}/com
export COMOUT=${COMROOT:?}/aigfs.${PDY}/${cyc}/products/atmos/cyclone/tracks
export KEEPDATA=NO

export forecast_length=${forecast_length:-64}
export forecast_hours=$((forecast_length * 6))
if [[ ${forecast_hours} > 240 ]]; then
  export FHMAX_CYCLONE=${FHMAX_CYCLONE:-240}
else
  export FHMAX_CYCLONE=${forecast_hours}
fi

# experiment configurations:
#export PDY=20250626
#export cyc=00
export job=aigfs_track_${cyc}
#member: EAGLE_SOLO:"", EAGLE_ENSEMBLE:C00, P01, ... , P30, weight: 0, 1, 2, ..., 30
# EAGLE SOLO:
#export pert=""
# EAGLE ensemble
#export pert="C00"
#model name has to be 4 letters, EAGLE_SOLO:MGFS, EAGLE_ENSEMBLE:MC00, MP01, ..., MP30
export pert=${gefs_member}
if [ "$pert" = "" ]; then
   #export COMINgfs=/scratch3/NCEPDEV/nems/Jun.Wang/tracker/input/graphcastgfs.${PDY}
   export COMINgfs=/scratch3/NCEPDEV/nems/Linlin.Cui/Tests/MLGEFSv1.0/oper/graphcastgfs.${PDY}
   export ensemble=""
   export fileprefix=graphcastgfs
   export modelname="MGFS"
else
   export COMINgfs=/scratch3/NCEPDEV/stmp/$USER/${SUBEXPT:-EAGLE_ensemble}/pmlgefs.$PDY/$cyc
   pertmember=`echo $pert | cut -c2-3`
   weight=$(expr $pertmember + 0)
   export ensmember=forecasts_13_levels_${pert}_model_${weight}
   export fileprefix=pmlgefs${pert}
   export modelname="M"$(echo "$pert" | tr '[:lower:]' '[:upper:]')
   #modelname=$(echo "$modelname" | tr '[:lower:]' '[:upper:]')
fi
#model history files
export COMINsyn=/scratch3/NCEPDEV/nems/Linlin.Cui/Tests/MLGEFSv1.0/oper/tracker/syndat
#export COMINsyn=/scratch3/NCEPDEV/nems/Jun.Wang/tracker/input/syndat

# CALL executable job script here
${PACKAGEROOT}/jobs/JAIGFS_CYCLONE_TRACK

if [ $? -ne 0 ]; then
  echo "tracker run FAILED"
  exit 1
else
  echo "tracker run FINISHED"
fi

# Deliver atcfunix track file
filename=$(echo "$modelname" | tr '[:upper:]' '[:lower:]')
if [ -e ${COMOUT}/${filename}p.t${cyc}z.cyclone.trackatcfunix ]; then
  cp -p ${COMOUT}/${filename}p.t${cyc}z.cyclone.trackatcfunix ${COMINgfs}/${ensmember}/
fi

#%include <tail.h> 
#%manual
######################################################################
#PURPOSE:  Executes the job that creates GFS TC track forecasts
######################################################################

######################################################################
# Job specific troubleshooting instructions:
#  see generic troubleshoot manual page
#
######################################################################

# include manual page below
#%end

